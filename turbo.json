{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": [
    "tsconfig.json",
    "scripts/build-esm-oxc.mjs",
    "scripts/helpers/relative-specifiers.mjs",
    "scripts/rewrite-dts-specifiers.mjs"
  ],
  "tasks": {
    "build:esm": {
      "dependsOn": ["^build:esm"],
      "outputs": ["esm/**"]
    },
    "build:types": {
      "dependsOn": ["^build:types", "@wyw-in-js/ts-config#check"],
      "outputs": ["types/**"]
    },
    "lint": {
      "dependsOn": ["@wyw-in-js/eslint-config#check"]
    },
    "test": {
      "dependsOn": []
    }
  }
}
